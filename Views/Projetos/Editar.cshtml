@model GerenciadorAcademico.ViewModels.EditarProjetoViewModel
@{
    ViewData["Title"] = "Editar projeto";
}

<div class="cabecalho-pagina">
    <div>
        <h1>Editar projeto</h1>
        <p class="subtitulo">Altere os dados necessários e salve as modificações.</p>
    </div>
</div>

<form asp-action="Editar" method="post" class="form-card" novalidate>
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="validation"></div>

    <partial name="_FormularioProjeto" model="Model" />

    <div class="form-actions">
        <button type="submit" class="button">Salvar alterações</button>
        <a asp-action="Index" class="button secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
