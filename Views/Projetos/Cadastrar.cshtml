@model GerenciadorAcademico.ViewModels.NovoProjetoViewModel
@{
    ViewData["Title"] = "Cadastrar projeto";
}

<div class="cabecalho-pagina">
    <div>
        <h1>Cadastrar projeto</h1>
        <p class="subtitulo">Informe os dados e escolha o professor responsável.</p>
    </div>
</div>

<form asp-action="Cadastrar" method="post" class="form-card" novalidate>
    <div asp-validation-summary="ModelOnly" class="validation"></div>

    <partial name="_FormularioProjeto" model="Model" />

    <div class="form-actions">
        <button type="submit" class="button">Salvar</button>
        <a asp-action="Index" class="button secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
